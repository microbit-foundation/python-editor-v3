# https://docs.circuitpython.org/en/10.3.0/shared-bindings/time/index.html
from typing import Iterator, Optional, Sequence, Tuple, overload

class struct_time(Sequence[int]):
    def __init__(self, time_tuple: Sequence[int]) -> None: ...
    tm_year: int
    tm_mon: int
    tm_mday: int
    tm_hour: int
    tm_min: int
    tm_sec: int
    tm_wday: int
    tm_yday: int
    tm_isdst: int
    def __len__(self) -> int: ...
    @overload
    def __getitem__(self, index: int) -> int: ...
    @overload
    def __getitem__(self, index: slice) -> Tuple[int, ...]: ...
    def __iter__(self) -> Iterator[int]: ...

def sleep(seconds: float) -> None:
    """Pause for the given number of seconds."""
    ...
def monotonic() -> float:
    """Elapsed seconds from an unspecified start, suitable for measuring intervals."""
    ...
def monotonic_ns() -> int: ...
def time() -> int: ...
def localtime(secs: Optional[int] = None) -> struct_time: ...
def mktime(t: Sequence[int]) -> int: ...
