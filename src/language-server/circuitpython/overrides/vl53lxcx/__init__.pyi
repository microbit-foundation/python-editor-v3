from typing import Iterable, List, Optional
from busio import I2C
from digitalio import DigitalInOut

DATA_DISTANCE_MM: int
DATA_TARGET_STATUS: int
RESOLUTION_4X4: int
RESOLUTION_8X8: int
STATUS_VALID: int
class Results:
    distance_mm: List[float]
    target_status: List[int]
class VL53LxCX:
    def __init__(self, i2c: I2C, addr: int = 0x29, lpn: Optional[DigitalInOut] = None) -> None: ...
    def reset(self) -> None: ...
    def is_alive(self) -> bool: ...
    def init(self) -> None: ...
    def start_ranging(self, enables: Iterable[int]) -> None: ...
    def stop_ranging(self) -> None: ...
    def check_data_ready(self) -> bool: ...
    def get_ranging_data(self) -> Results: ...
    @property
    def resolution(self) -> int: ...
    @resolution.setter
    def resolution(self, resolution: int) -> None: ...
    @property
    def ranging_freq(self) -> int: ...
    @ranging_freq.setter
    def ranging_freq(self, freq: int) -> None: ...
class VL53L5CX(VL53LxCX): ...
class VL53L8CX(VL53LxCX): ...
